[Unit]
Description=Desktop Panel for XFCE or Cinnamon X11
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
Environment=GDK_BACKEND=x11
ExecStart=/usr/libexec/monolito-panel/session run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
